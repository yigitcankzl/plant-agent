"[{\"id\": \"D01\", \"item\": \"SWWRF location\", \"quote\": \"The SWWRF is located at 3800 54th Avenue South\", \"source\": \"p.10 Sec 2.1\", \"unit\": \"--\", \"value\": \"3800 54th Avenue South, St. Petersburg, FL\"}, {\"id\": \"D02\", \"item\": \"Permitted AADF\", \"quote\": \"permitted to treat an annual average daily flow (AADF) of 20 million gallons per day (MGD)\", \"source\": \"p.8 Sec 1\", \"unit\": \"MGD\", \"value\": \"20\"}, {\"id\": \"D03\", \"item\": \"AWWRF conversion plan\", \"quote\": \"discontinue the operation at the Albert Whitted WRF (AWWRF) and convert it into a master pump station which will pump its wastewater to the SWWRF\", \"source\": \"p.18 Sec 3\", \"unit\": \"--\", \"value\": \"AWWRF to SWWRF diversion\"}, {\"id\": \"D04\", \"item\": \"Wet-weather design flows\", \"quote\": \"Annual Average 20.0; Maximum Month 31.4; Maximum Day 52.6; Peak Hour 69.0\", \"source\": \"p.22 Table 3-3\", \"unit\": \"MGD\", \"value\": \"20.0 / 31.4 / 52.6 / 69.0\"}, {\"id\": \"D05\", \"item\": \"Wet-weather CBOD5 loads AA/MM/MD/PH\", \"quote\": \"Annual Average 35,862; Maximum Month 46,621; Maximum Day 71,003; Peak Hour 89,954\", \"source\": \"p.22 Table 3-3\", \"unit\": \"lb/d\", \"value\": \"35862 / 46621 / 71003 / 89954\"}, {\"id\": \"D06\", \"item\": \"Wet-weather TSS loads AA/MM/MD/PH\", \"quote\": \"Annual Average 40,032; Maximum Month 52,042; Maximum Day 79,259; Peak Hour 100,413\", \"source\": \"p.22 Table 3-3\", \"unit\": \"lb/d\", \"value\": \"40032 / 52042 / 79259 / 100413\"}, {\"id\": \"D07\", \"item\": \"Wet-weather TKN loads AA/MM/MD/PH\", \"quote\": \"Annual Average 6,750; Maximum Month 8,775; Maximum Day 13,364; Peak Hour 16,931\", \"source\": \"p.22 Table 3-3\", \"unit\": \"lb/d\", \"value\": \"6750 / 8775 / 13364 / 16931\"}, {\"id\": \"D08\", \"item\": \"Wet-weather TP loads AA/MM/MD/PH\", \"quote\": \"Annual Average 998; Maximum Month 1,298; Maximum Day 1,976; Peak Hour 2,504\", \"source\": \"p.22 Table 3-3\", \"unit\": \"lb/d\", \"value\": \"998 / 1298 / 1976 / 2504\"}, {\"id\": \"D09\", \"item\": \"Historical combined SWWRF+AWWRF annual average flows 2007-2013\", \"quote\": \"Annual Average (MGD) 14.25 15.22 15.54 16.10 16.52 16.43 17.80\", \"source\": \"p.18 Table 3-1\", \"unit\": \"MGD\", \"value\": \"14.25 / 15.22 / 15.54 / 16.10 / 16.52 / 16.43 / 17.80\"}, {\"id\": \"D10\", \"item\": \"Historical combined max month 2007-2013\", \"quote\": \"Maximum Month (MGD) 18.22 18.63 21.67 21.35 22.96 23.70 27.89\", \"source\": \"p.18 Table 3-1\", \"unit\": \"MGD\", \"value\": \"18.22 / 18.63 / 21.67 / 21.35 / 22.96 / 23.70 / 27.89\"}, {\"id\": \"D11\", \"item\": \"Historical combined max week 2007-2013\", \"quote\": \"Maximum Week (MGD) 21.72 20.24 23.93 25.84 27.00 32.91 37.20\", \"source\": \"p.18 Table 3-1\", \"unit\": \"MGD\", \"value\": \"21.72 / 20.24 / 23.93 / 25.84 / 27.00 / 32.91 / 37.20\"}, {\"id\": \"D12\", \"item\": \"Historical combined max day 2007-2013\", \"quote\": \"Maximum Day (MGD) 27.37 22.42 29.12 30.98 32.93 47.78 46.82\", \"source\": \"p.18 Table 3-1\", \"unit\": \"MGD\", \"value\": \"27.37 / 22.42 / 29.12 / 30.98 / 32.93 / 47.78 / 46.82\"}, {\"id\": \"D13\", \"item\": \"Historical combined peak hour 2012-2013\", \"quote\": \"Peak Hour (MGD) n/a n/a n/a n/a n/a 54.25 60.72\", \"source\": \"p.18 Table 3-1\", \"unit\": \"MGD\", \"value\": \"54.25 in 2012, 60.72 in 2013\"}, {\"id\": \"D14\", \"item\": \"Peak hour / annual average peaking factor\", \"quote\": \"Peak Hour/Annual Average n/a n/a n/a n/a n/a 3.30 3.41\", \"source\": \"p.19 Table 3-2\", \"unit\": \"--\", \"value\": \"3.30 (2012), 3.41 (2013)\"}, {\"id\": \"D15\", \"item\": \"Observed max storm increment above dry weather 2012-2013\", \"quote\": \"maximum wet weather flow contribution in excess of the dry weather flow of approximately 43.2 MGD\", \"source\": \"p.20 Sec 3.1\", \"unit\": \"MGD\", \"value\": \"43.2\"}, {\"id\": \"D16\", \"item\": \"Projected total (dry + storm) before rounding\", \"quote\": \"total projected flow to the SWWRF would be 68.7 MGD (25.5 MGD + 43.2 MGD)\", \"source\": \"p.20 Sec 3.1\", \"unit\": \"MGD\", \"value\": \"68.7 = 25.5 + 43.2\"}, {\"id\": \"D17\", \"item\": \"Projected dry-weather diurnal range at 20 MGD design\", \"quote\": \"projected dry weather flow to the SWWRF at 20 MGD design flow conditions would range from 14 MGD to 25.5 MGD\", \"source\": \"p.19 Sec 3.1\", \"unit\": \"MGD\", \"value\": \"14 to 25.5 (diurnal factors 0.71 to 1.27)\"}, {\"id\": \"D18\", \"item\": \"High-flow occurrence statistics\", \"quote\": \"hourly flows higher than 40 MGD happened less than 1% of the times and the duration of the main storm events generally did not extend more than a day\", \"source\": \"p.19 Sec 3.1\", \"unit\": \"--\", \"value\": \" >40 MGD <1% of time, storm <1 day; max 24-hr rolling avg 50.5 MGD; >60 MGD only two consecutive hours (0.01% probability)\"}, {\"id\": \"D19\", \"item\": \"Coarse screens\", \"quote\": \"Coarse Screens Number 2 Located in the influent wet well\", \"source\": \"p.13 Table 2-1\", \"unit\": \"--\", \"value\": \"2\"}, {\"id\": \"D20\", \"item\": \"Fine screens\", \"quote\": \"Fine Screens Number 2 Located in the headworks structure\", \"source\": \"p.13 Table 2-1\", \"unit\": \"--\", \"value\": \"2\"}, {\"id\": \"D21\", \"item\": \"Influent (submersible) pumps\", \"quote\": \"Submersible Pumps Number 4; Horsepower HP 150\", \"source\": \"p.13 Table 2-1\", \"unit\": \"HP\", \"value\": \"4 pumps x 150 HP\"}, {\"id\": \"D22\", \"item\": \"Grit removal\", \"quote\": \"Low Energy Centrifugal Number 2\", \"source\": \"p.13 Table 2-1\", \"unit\": \"--\", \"value\": \"2\"}, {\"id\": \"D23\", \"item\": \"Old-plant aeration basins\", \"quote\": \"Number of Basins 2 Circular; Dimensions (diameter x depth) ft 65 x 13; Total Reactor Volume MG 0.65\", \"source\": \"p.13 Table 2-1\", \"unit\": \"ft / MG\", \"value\": \"2 x 65-ft dia x 13-ft deep; 0.65 MG total\"}, {\"id\": \"D24\", \"item\": \"New-plant aeration basins\", \"quote\": \"Number of Basins 2 Rectangular; Dimensions (L x W x D) ft 268 x 67 x 15; Total Reactor Volume MG 4.03\", \"source\": \"p.13 Table 2-1\", \"unit\": \"ft / MG\", \"value\": \"2 basins 268x67x15 ft; 4.03 MG total\"}, {\"id\": \"D25\", \"item\": \"Old-plant secondary clarifiers\", \"quote\": \"Number 2 Circular; Diameter ft 65; Side Water Depth ft 13; Total Clarifier Volume MG 0.64\", \"source\": \"p.13 Table 2-1\", \"unit\": \"ft / MG\", \"value\": \"2 x 65-ft dia, 13-ft SWD; 0.64 MG\"}, {\"id\": \"D26\", \"item\": \"New-plant secondary clarifiers\", \"quote\": \"Number 3 Circular; Diameter ft 135; Side Water Depth ft 12 (#1 & #2) - 15 (#3); Total Clarifier Volume MG 3.85\", \"source\": \"p.13 Table 2-1\", \"unit\": \"ft / MG\", \"value\": \"3 x 135-ft dia; SWD 12 ft (#1,#2), 15 ft (#3); 3.85 MG\"}, {\"id\": \"D27\", \"item\": \"RAS pump capacity\", \"quote\": \"RAS Pump Capacity GPM 3 pumps at 4,200\", \"source\": \"p.13 Table 2-1\", \"unit\": \"GPM\", \"value\": \"3 x 4200 GPM\"}, {\"id\": \"D28\", \"item\": \"Deep-bed filters\", \"quote\": \"Number of Filters 4; Dimensions (L x W x D) ft 38 x 37 x 9; Total Filter Area ft2 5,624\", \"source\": \"p.13 Table 2-1\", \"unit\": \"ft / ft2\", \"value\": \"4 filters 38x37x9 ft; 5624 ft2 total\"}, {\"id\": \"D29\", \"item\": \"Disinfection (chlorine contact)\", \"quote\": \"Number of CCTs 2 Uses liquid sodium hypochlorite; Dimensions (L x W x D) ft 88 x 103 x 7; Total Volume ft3 126,896\", \"source\": \"p.13 Table 2-1\", \"unit\": \"ft / ft3\", \"value\": \"2 CCTs 88x103x7 ft; 126896 ft3\"}, {\"id\": \"D30\", \"item\": \"Reclaimed water storage tanks\", \"quote\": \"Number of Tanks 2; Volume MG 5, 10\", \"source\": \"p.13 Table 2-1\", \"unit\": \"MG\", \"value\": \"2 tanks: 5 MG and 10 MG\"}, {\"id\": \"D31\", \"item\": \"Effluent pumping\", \"quote\": \"Pumps Number 5; Capacity MGD 39.6\", \"source\": \"p.13 Table 2-1\", \"unit\": \"MGD\", \"value\": \"5 pumps, 39.6 MGD capacity\"}, {\"id\": \"D32\", \"item\": \"Deep-well disposal capacity\", \"quote\": \"Deep Wells Capacity MGD 27\", \"source\": \"p.13 Table 2-1\", \"unit\": \"MGD\", \"value\": \"27\"}, {\"id\": \"D33\", \"item\": \"Filter overflow (blinded-filter) elevation used in model\", \"quote\": \"hydraulic elevation in the filters was conservatively maintained at the filter overflow elevation of 115.3 feet\", \"source\": \"p.28 Sec 5\", \"unit\": \"ft\", \"value\": \"115.3\"}, {\"id\": \"D34\", \"item\": \"Model construction basis\", \"quote\": \"constructed using available as-built drawings and other facility data provided by City\", \"source\": \"p.28 Sec 5\", \"unit\": \"--\", \"value\": \"as-built drawings + City data\"}, {\"id\": \"D35\", \"item\": \"Survey basis for structure elevations\", \"quote\": \"ELEVATIONS OF EXISTING STRUCTURES BASED UPON SURVEY PERFORMED BY McKIM & CREED, OCTOBER 2013\", \"source\": \"dwg p.30 notes (read_drawing)\", \"unit\": \"--\", \"value\": \"McKim & Creed survey Oct 2013\"}, {\"id\": \"D36\", \"item\": \"Profile RAS rate\", \"quote\": \"PROFILE WAS MODELED USING A RAS FLOWRATE OF 20 MGD\", \"source\": \"dwg p.30 notes (read_drawing)\", \"unit\": \"MGD\", \"value\": \"20\"}, {\"id\": \"D37\", \"item\": \"Biosolids-to-Energy flow-meter change\", \"quote\": \"The 30-inch flow meter that was shown to be a hydraulic restriction at the proposed peak flow rates will be taken out of the flow path and a new 48-inch flow meter will be located immediately upstream of the primary clarifier splitter box\", \"source\": \"p.28 Sec 5.1\", \"unit\": \"inch\", \"value\": \"remove 30-in, add 48-in upstream of primary splitter\"}, {\"id\": \"D38\", \"item\": \"New primary clarifiers count\", \"quote\": \"two primary clarifiers are proposed to be located hydraulically between the headworks and the aeration basin splitter box\", \"source\": \"p.28 Sec 5.1\", \"unit\": \"--\", \"value\": \"2 new primary clarifiers\"}, {\"id\": \"D39\", \"item\": \"Primary splitter cutthroat flumes sizing\", \"quote\": \"The cutthroat flumes have been sized to each pass future average and peak flow individually without entering submerged flow condition\", \"source\": \"p.28 Sec 5.1\", \"unit\": \"--\", \"value\": \"each flume passes future avg and peak unsubmerged\"}, {\"id\": \"D40\", \"item\": \"Reported 40 MGD check\", \"quote\": \"At 40 MGD flow, none of the unit processes were hydraulically challenged as shown in Figure 5-1\", \"source\": \"p.29 Sec 5.2\", \"unit\": \"MGD\", \"value\": \"40\"}, {\"id\": \"D41\", \"item\": \"Reported 69 MGD failure description\", \"quote\": \"upon running the future peak wet weather flow of 69 MGD, the hydraulic elements failed to hold proper hydraulic gradients. The losses through the hydraulic elements were so great that the hydraulic grade line in all of the elements exceeded the top of the wall for the simulated process units\", \"source\": \"p.29 Sec 5.2\", \"unit\": \"MGD\", \"value\": \"69\"}, {\"id\": \"D42\", \"item\": \"Reported hydraulic capacity + limiter\", \"quote\": \"it was determined that the hydraulic capacity for the SWWRF was limited to 40.5 MGD. The limiting unit process at that flow was the filters\", \"source\": \"p.29 Sec 5.2\", \"unit\": \"MGD\", \"value\": \"40.5 limited by filters\"}, {\"id\": \"D43\", \"item\": \"Bottleneck list at 69 MGD\", \"quote\": \"Effluent Weir Channel at Chlorine Contact Basin; 54-inch pipe between Filters and Chlorine Contact Basin; 24-inch pipe from Filter #4 to Filter #3; 48-inch pipe between Secondary Clarifiers and Filters; 48-inch pipe between Aeration Basin to Secondary Clarifiers\", \"source\": \"p.29 Sec 5.2\", \"unit\": \"inch\", \"value\": \"CCB weir channel, 54-in, 24-in, 48-in, 48-in\"}, {\"id\": \"D44\", \"item\": \"Additional headloss units at 69 MGD\", \"quote\": \"the future peak wet weather flow of 69 MGD caused increased headloss through the Screens, Secondary Clarifiers Splitter Box, Secondary Clarifiers and Filtration process units\", \"source\": \"p.29 Sec 5.2\", \"unit\": \"--\", \"value\": \"Screens, SC splitter, SCs, Filters\"}, {\"id\": \"D45\", \"item\": \"Drawing flow-path order\", \"quote\": \"HEADWORKS / PRIMARY CLARIFIER SPLITTER BOX / PRIMARY CLARIFIER No.1 / STEP FEED SPLITTER BOX / SPLITTER BOX No.1 / AERATION BASIN / SPLITTER BOX No.2 / CLARIFIER No.3 / FILTERS / CHLORINE CONTACT BASIN\", \"source\": \"dwg p.30 flow_path (read_drawing)\", \"unit\": \"--\", \"value\": \"headworks to CCB in listed order\"}, {\"id\": \"D46\", \"item\": \"Drawing title / condition\", \"quote\": \"Figure 5-1. SWWRF Hydraulic Profile after Biosolids to Energy Project Improvements\", \"source\": \"p.30 Sec 5 (dwg p.30)\", \"unit\": \"--\", \"value\": \"profile after Biosolids to Energy improvements\"}]}"