"[{\"id\": \"DR-INT-01\", \"item\": \"River intake high water elevation\", \"quote\": \"HIGH WATER ELEVATION 453.0\", \"source\": \"dwg p.136\", \"unit\": \"ft\", \"value\": \"453.0\"}, {\"id\": \"DR-INT-02\", \"item\": \"River intake water surface shown\", \"quote\": \"450.0\", \"source\": \"dwg p.136\", \"unit\": \"ft\", \"value\": \"450.0\"}, {\"id\": \"DR-INT-03\", \"item\": \"Ordinary high water elevation\", \"quote\": \"ORDINARY HIGH WATER ELEVATION 432+/-\", \"source\": \"dwg p.136\", \"unit\": \"ft\", \"value\": \"432\"}, {\"id\": \"DR-INT-04\", \"item\": \"Ordinary low water elevation\", \"quote\": \"ORDINARY LOW WATER ELEVATION 420+/-\", \"source\": \"dwg p.136\", \"unit\": \"ft\", \"value\": \"420\"}, {\"id\": \"DR-INT-05\", \"item\": \"Intake floor elevation\", \"quote\": \"408.0\", \"source\": \"dwg p.136\", \"unit\": \"ft\", \"value\": \"408.0\"}, {\"id\": \"DR-INT-06\", \"item\": \"Intake firm capacity Sept 14 2006 test with Pumps 1,2,4 operating\", \"quote\": \"with Pump Nos. 1, 2 and 4 operating, the intake provided only 14 mgd\", \"source\": \"p.109\", \"unit\": \"mgd\", \"value\": \"14\"}, {\"id\": \"DR-INT-07\", \"item\": \"Intake firm capacity 2002 test\", \"quote\": \"firm capacity of the station at that time was approximately 15.0 mgd\", \"source\": \"p.109\", \"unit\": \"mgd\", \"value\": \"15.0\"}, {\"id\": \"DR-INT-08\", \"item\": \"Pump No.3 performance note\", \"quote\": \"Pump No. 3 is pumping substantially below its rated capacity\", \"source\": \"p.109\", \"unit\": \"none\", \"value\": \"Pump 3 below rated; Pump 3 not operating during Sept 14 2006 test and capacity even lower\"}, {\"id\": \"DR-RW-01\", \"item\": \"Raw water pipeline diameter and material\", \"quote\": \"underground 30-inch diameter steel raw water pipeline\", \"source\": \"p.110\", \"unit\": \"in\", \"value\": \"30 steel\"}, {\"id\": \"DR-RW-02\", \"item\": \"Raw water pipeline wall thickness\", \"quote\": \"steel pipe has a 1/4-inch wall thickness\", \"source\": \"p.110\", \"unit\": \"in\", \"value\": \"0.25\"}, {\"id\": \"DR-RW-03\", \"item\": \"Raw water magnetic flow meter\", \"quote\": \"30-inch magnetic flow meter was installed on this pipeline in a below-grade vault in 2002\", \"source\": \"p.110\", \"unit\": \"in\", \"value\": \"30\"}, {\"id\": \"DR-RM-01\", \"item\": \"Rapid mix top of wall\", \"quote\": \"467.5\", \"source\": \"dwg p.136\", \"unit\": \"ft\", \"value\": \"467.5\"}, {\"id\": \"DR-RM-02\", \"item\": \"Rapid mix water surface\", \"quote\": \"466.0\", \"source\": \"dwg p.136\", \"unit\": \"ft\", \"value\": \"466.0\"}, {\"id\": \"DR-FLOC-01\", \"item\": \"Flocculation basin invert\", \"quote\": \"454.0\", \"source\": \"dwg p.136\", \"unit\": \"ft\", \"value\": \"454.0\"}, {\"id\": \"DR-SED-01\", \"item\": \"Sedimentation basin invert\", \"quote\": \"454.0\", \"source\": \"dwg p.136\", \"unit\": \"ft\", \"value\": \"454.0\"}, {\"id\": \"DR-SED-02\", \"item\": \"Sedimentation max water surface\", \"quote\": \"MAX WS 465.98\", \"source\": \"dwg p.136\", \"unit\": \"ft\", \"value\": \"465.98\"}, {\"id\": \"DR-SED-03\", \"item\": \"Sedimentation overflow weir\", \"quote\": \"OF WEIR 465.00\", \"source\": \"dwg p.136\", \"unit\": \"ft\", \"value\": \"465.00\"}, {\"id\": \"DR-SED-04\", \"item\": \"Sedimentation water surface\", \"quote\": \"WS 464.83\", \"source\": \"dwg p.136\", \"unit\": \"ft\", \"value\": \"464.83\"}, {\"id\": \"DR-SED-05\", \"item\": \"Single pretreatment basin rating\", \"quote\": \"single existing basin is rated at 12 mgd\", \"source\": \"p.111\", \"unit\": \"mgd\", \"value\": \"12\"}, {\"id\": \"DR-SED-06\", \"item\": \"Demonstrated warm-weather pretreatment flow\", \"quote\": \"excellent pretreatment prior to filtration at sustained flows up to 11.5 mgd during warm weather, low turbidity\", \"source\": \"p.111\", \"unit\": \"mgd\", \"value\": \"11.5\"}, {\"id\": \"DR-SED-07\", \"item\": \"Cold high-turbidity normal flows\", \"quote\": \"Normal plant flows during high turbidity, colder water conditions have ranged from 3.5 to 5.0 mgd\", \"source\": \"p.111\", \"unit\": \"mgd\", \"value\": \"3.5 to 5.0\"}, {\"id\": \"DR-SED-08\", \"item\": \"Solids removal equipment\", \"quote\": \"Settled solids continuously removed by chain-and-flight system\", \"source\": \"p.111\", \"unit\": \"none\", \"value\": \"chain-and-flight\"}, {\"id\": \"DR-FILT-01\", \"item\": \"Filters top of wall\", \"quote\": \"467.5\", \"source\": \"dwg p.136\", \"unit\": \"ft\", \"value\": \"467.5\"}, {\"id\": \"DR-FILT-02\", \"item\": \"Filter reference elevation 464.0\", \"quote\": \"464.0\", \"source\": \"dwg p.136\", \"unit\": \"ft\", \"value\": \"464.0\"}, {\"id\": \"DR-FILT-03\", \"item\": \"Filter influent pipe per filter\", \"quote\": \"enters each filter via a 20-inch pipe with isolation valve\", \"source\": \"p.112\", \"unit\": \"in\", \"value\": \"20\"}, {\"id\": \"DR-FILT-04\", \"item\": \"Normal filter operating level\", \"quote\": \"normal filter operating level ranges from 463 to 464 feet as controlled by filter effluent flow control\", \"source\": \"p.112\", \"unit\": \"ft\", \"value\": \"463 to 464\"}, {\"id\": \"DR-FILT-05\", \"item\": \"Submergence over media\", \"quote\": \"provides 5 to 6 feet of submergence over top of filter media\", \"source\": \"p.112\", \"unit\": \"ft\", \"value\": \"5 to 6\"}, {\"id\": \"DR-FTW-01\", \"item\": \"Filter-to-waste demonstrated flow\", \"quote\": \"filter-to-waste flow was approximately 2 mgd\", \"source\": \"p.113\", \"unit\": \"mgd\", \"value\": \"2\"}, {\"id\": \"DR-FTW-02\", \"item\": \"Filter-to-waste test condition\", \"quote\": \"cleaning and a raw water flow of 9.1 mgd, flow through filter No.1 in filter-to-waste estimated by difference between raw water and combined effluent through filters No.2 and No.4\", \"source\": \"p.113\", \"unit\": \"mgd\", \"value\": \"9.1 raw; >3.4 each through Nos.2 and 4 during waste\"}, {\"id\": \"DR-FTW-03\", \"item\": \"Filter-to-waste limit vs expansion\", \"quote\": \"existing filter-to-waste piping does not appear to convey more than 2 mgd, any plan to increase WTP capacity beyond 18 mgd may require reconfiguring\", \"source\": \"p.113\", \"unit\": \"mgd\", \"value\": \"2 limit; reconfig beyond 18\"}, {\"id\": \"DR-CW-01\", \"item\": \"Clearwell zone 1 under four filters\", \"quote\": \"Unbaffled area under four filters max ~170,000 gallons at 10.5 foot water depth\", \"source\": \"p.114\", \"unit\": \"gal\", \"value\": \"170000 at 10.5 ft\"}, {\"id\": \"DR-CW-02\", \"item\": \"Clearwell zone 2 baffled\", \"quote\": \"Baffled clearwell area underneath chemical rooms and blower room max ~324,000 gallons at 10.5 ft\", \"source\": \"p.114\", \"unit\": \"gal\", \"value\": \"324000 at 10.5 ft\"}, {\"id\": \"DR-CW-03\", \"item\": \"Clearwell zone 3 under HS pump room\", \"quote\": \"Unbaffled area underneath high service pump room max ~133,000 gallon at 10.5 ft\", \"source\": \"p.114\", \"unit\": \"gal\", \"value\": \"133000 at 10.5 ft\"}, {\"id\": \"DR-CW-04\", \"item\": \"Total clearwell max volume and detention at 12 mgd\", \"quote\": \"total maximum treated water storage 627,000 gallons represents approximately 75 minutes (1.26 hours) at current max 12 mgd\", \"source\": \"p.114\", \"unit\": \"gal; min\", \"value\": \"627000; 75 (1.26 hr)\"}, {\"id\": \"DR-CW-05\", \"item\": \"Clearwell level drop during backwash\", \"quote\": \"level in clearwell drops about 1.0 feet [during backwash]\", \"source\": \"p.114\", \"unit\": \"ft\", \"value\": \"1.0\"}, {\"id\": \"DR-CW-06\", \"item\": \"HSPS clearwell overflow weir\", \"quote\": \"high service pump station clearwell overflow weir is at elevation 449.5 feet with weir length ~9 feet\", \"source\": \"p.114\", \"unit\": \"ft\", \"value\": \"449.5 x 9\"}, {\"id\": \"DR-CW-07\", \"item\": \"HSPS overflow capacity\", \"quote\": \"At 1 foot of water depth over the weir, overflow capacity is approximately 19 mgd\", \"source\": \"p.114\", \"unit\": \"mgd\", \"value\": \"19 at 1 ft\"}, {\"id\": \"DR-CW-08\", \"item\": \"Overflow chamber and outfall pipe\", \"quote\": \"overflow water discharged into overflow chamber 4.5 ft by 4.5 ft then into 18-inch diameter pipeline to outfall on bank of North Umpqua River\", \"source\": \"p.114\", \"unit\": \"ft; in\", \"value\": \"4.5x4.5; 18\"}, {\"id\": \"DR-CW-09\", \"item\": \"Filter No.3 clearwell overflow\", \"quote\": \"clearwell overflow below Filter No.3 at elevation 450.00 feet with weir length ~15 feet\", \"source\": \"p.114\", \"unit\": \"ft\", \"value\": \"450.00 x 15\"}, {\"id\": \"DR-CW-10\", \"item\": \"Combined overflow capacity\", \"quote\": \"Combined, two overflow weirs can accommodate ultimate plant flow of 24 mgd\", \"source\": \"p.114\", \"unit\": \"mgd\", \"value\": \"24\"}, {\"id\": \"DR-CW-11\", \"item\": \"Normal clearwell operating band\", \"quote\": \"high service pumps operate to maintain clearwell level relatively constant between ~8 ft and 10 ft depth, which is 3 to 1 ft below overflow weir\", \"source\": \"p.114\", \"unit\": \"ft depth\", \"value\": \"8-10; 3-1 below weir\"}, {\"id\": \"DR-CW-12\", \"item\": \"Backwash volume per filter\", \"quote\": \"One filter backwash uses 65,000 to 75,000 gallons with higher volume used during summer\", \"source\": \"p.114\", \"unit\": \"gal\", \"value\": \"65000-75000\"}, {\"id\": \"DR-CW-13\", \"item\": \"Daily backwash water use\", \"quote\": \"Since all four filters are backwashed once per day, approximately 260,000 to 300,000 gallons finished water used daily\", \"source\": \"p.114\", \"unit\": \"gal/day\", \"value\": \"260000-300000\"}, {\"id\": \"DR-CW-14\", \"item\": \"Clearwell invert and references\", \"quote\": \"438.5 invert; 449.0; 452.0; 449.5 OF WEIR; 453.5\", \"source\": \"dwg p.136\", \"unit\": \"ft\", \"value\": \"438.5 invert; 449.5 weir\"}, {\"id\": \"DR-CW-15\", \"item\": \"Added storage with Filters 5-6 and detention at 18 mgd\", \"quote\": \"When plant expanded with two additional filters, additional 85,000 gallons added under Filters 5 and 6, At expanded 18 mgd max detention would then be 57 minutes\", \"source\": \"p.115\", \"unit\": \"gal; min\", \"value\": \"85000; 57 at 18 mgd\"}, {\"id\": \"DR-CW-16\", \"item\": \"Clearwell needed at 24 mgd\", \"quote\": \"At 24 mgd using 1-hour criteria, suggested minimum 1,000,000 gallons which is 288,000 gallons more than will be available when ultimate buildout of six filters achieved\", \"source\": \"p.115\", \"unit\": \"gal\", \"value\": \"1000000 needed; 288000 short\"}, {\"id\": \"DR-HS-01\", \"item\": \"High service Pump No.1 rating\", \"quote\": \"One pump (No.1) rated at 1,400 gpm (2.0 mgd) at 305 feet TDH, with 150 hp motor\", \"source\": \"p.115\", \"unit\": \"gpm (mgd); ft; hp\", \"value\": \"1400 (2.0) at 305; 150\"}, {\"id\": \"DR-HS-02\", \"item\": \"High service Pumps 2-4 rating\", \"quote\": \"Three pumps (Nos.2,3,4) each rated at 2,800 gpm (4.0 mgd) at 305 feet TDH, with 300 hp motors\", \"source\": \"p.115\", \"unit\": \"gpm (mgd); ft; hp\", \"value\": \"2800 (4.0) at 305; 300\"}, {\"id\": \"DR-HS-03\", \"item\": \"HSPS vintage and spaces\", \"quote\": \"All four constant speed pumps installed in Phase 2, High Service Pump Station phase, in 1987-1988. Space provided for two additional pumps\", \"source\": \"p.115\", \"unit\": \"none\", \"value\": \"1987-88; +2 spaces\"}, {\"id\": \"DR-HS-04\", \"item\": \"HSPS VFDs\", \"quote\": \"City recently installed VFD on Pump No.2 [and] in process of installing new VFDs on one raw water pump and one finished water pump\", \"source\": \"p.115\", \"unit\": \"none\", \"value\": \"VFD on Pump 2; VFDs on 1 raw +1 finished\"}, {\"id\": \"DR-HS-05\", \"item\": \"HSPS firm capacity and actual\", \"quote\": \"current firm capacity nominally 10 mgd. Since three largest pumps operate at approximately 3,300 gpm each under current hydraulic conditions\", \"source\": \"p.115\", \"unit\": \"mgd; gpm\", \"value\": \"10 firm; ~3300 each actual\"}, {\"id\": \"DR-FW-01\", \"item\": \"On-site finished water header\", \"quote\": \"steel header varies from 18-inch diameter at east end to 30-inch diameter at west end\", \"source\": \"p.116\", \"unit\": \"in\", \"value\": \"18 to 30\"}, {\"id\": \"DR-FW-02\", \"item\": \"Buried finished water main ID and wall\", \"quote\": \"finished water transmission pipeline wall is 3/8-inch thick and inside diameter is 29.25-inches\", \"source\": \"p.116\", \"unit\": \"in\", \"value\": \"29.25 ID; 0.375 wall\"}, {\"id\": \"DR-FW-03\", \"item\": \"Finished water propeller meter\", \"quote\": \"30-inch diameter propeller meter installed in vault on transmission main within WTP site\", \"source\": \"p.116\", \"unit\": \"in\", \"value\": \"30\"}, {\"id\": \"DR-FW-04\", \"item\": \"Finished water main hydraulics table\", \"quote\": \"TABLE 4-3: 8 mgd 2.65 fps 0.109 ft 0.05 ft/100ft; 12 mgd 3.98 0.246 0.11; 18 mgd 5.97 0.553 0.25; 20 mgd 6.63 0.682 0.32; 24 mgd 7.96 0.984 0.44\", \"source\": \"p.117\", \"unit\": \"mgd; fps; ft; ft/100ft\", \"value\": \"see quote; 5.97 fps at 18 mgd\"}, {\"id\": \"DR-FW-05\", \"item\": \"Surge tank volume\", \"quote\": \"1,900 cubic feet (14,200-gallon) tank designed to provide both upsurge and downsurge protection\", \"source\": \"p.117\", \"unit\": \"cu ft (gal)\", \"value\": \"1900 (14200)\"}, {\"id\": \"DR-FW-06\", \"item\": \"Surge criteria\", \"quote\": \"Surge protection provided for pumping rates up to 9,700 gpm (14.0 mgd); max upsurge controlled to 150 psi; minimum downsurge at HSPS controlled to HGL 630 feet (~175 ft head or 75 psi assuming plant ground elevation 455 ft)\", \"source\": \"p.117\", \"unit\": \"gpm (mgd); psi; ft\", \"value\": \"9700 (14.0); 150; 630\"}, {\"id\": \"DR-FW-07\", \"item\": \"Off-site transmission mains\", \"quote\": \"20-inch outside diameter steel main with 3/16-inch wall and 30-inch diameter Class 50 ductile iron main\", \"source\": \"p.117\", \"unit\": \"in\", \"value\": \"20 OD steel; 30 DI\"}, {\"id\": \"DR-FW-08\", \"item\": \"Transmission improvements\", \"quote\": \"Phase 1 ~9,400 feet new parallel piping; Phase 2 easterly/southerly 27-inch ~1,600 ft paralleling existing 24-inch; anticipated new 30-inch to replace 27-inch plus second parallel 30-inch future\", \"source\": \"p.118\", \"unit\": \"ft; in\", \"value\": \"9400; 1600 of 27-in; future 2x30-in\"}, {\"id\": \"DR-FW-09\", \"item\": \"Reservoir datum\", \"quote\": \"710.0 RESERVOIR\", \"source\": \"dwg p.136\", \"unit\": \"ft\", \"value\": \"710.0\"}, {\"id\": \"DR-BW-01\", \"item\": \"Air scour blower\", \"quote\": \"blower capacity 1,050 scfm at 6.4 psi driven by 60 hp motor; 8-inch air supply; electrically operated butterfly valve\", \"source\": \"p.118\", \"unit\": \"scfm; psi; hp; in\", \"value\": \"1050 at 6.4; 60; 8\"}, {\"id\": \"DR-BW-02\", \"item\": \"Backwash pumps rating\", \"quote\": \"two constant-speed vertical turbine backwash pumps, each 50 hp, rated 3,250 gpm at 41 feet TDH. Only one required; second spare\", \"source\": \"p.118-p.119\", \"unit\": \"gpm; ft; hp\", \"value\": \"3250 at 41; 50\"}, {\"id\": \"DR-BW-03\", \"item\": \"Backwash header\", \"quote\": \"backwash pumps discharge into 16-inch diameter header feeding individual filters\", \"source\": \"p.119\", \"unit\": \"in\", \"value\": \"16\"}, {\"id\": \"DR-BW-04\", \"item\": \"Deep-bed future backwash need and test\", \"quote\": \"optimum backwash rate for bays with deep bed media (up to 1.1 mm anthracite) ~4,400 gpm. When tested Sept 14 2006 with valve ~45 deg open, pumps produced 4,060 gpm\", \"source\": \"p.119\", \"unit\": \"gpm; mm\", \"value\": \"4400 needed; 4060 tested\"}, {\"id\": \"DR-BW-05\", \"item\": \"Backwash drains and conveyance\", \"quote\": \"16-inch backwash drain per filter into conveyance channel under gallery slab; via 24-inch pipeline to drain manhole then 30-inch pipeline to wastewater pump station\", \"source\": \"p.119\", \"unit\": \"in\", \"value\": \"16; 24; 30\"}, {\"id\": \"DR-WW-01\", \"item\": \"Wastewater pumps\", \"quote\": \"three 35 hp submersible solids handling pumps, each ~1,500 gpm at 40 ft TDH; 10-inch discharge with isolation and check valves\", \"source\": \"p.119\", \"unit\": \"gpm; ft; hp; in\", \"value\": \"1500 at 40; 35; 10\"}, {\"id\": \"DR-WW-02\", \"item\": \"Wastewater transfer main and firm capacity\", \"quote\": \"16-inch transfer main to basins 1 and 2. Approximate firm capacity 3,000 gpm with one pump out\", \"source\": \"p.119\", \"unit\": \"in; gpm\", \"value\": \"16; 3000 firm\"}, {\"id\": \"DR-WW-03\", \"item\": \"Washwater/solids basins\", \"quote\": \"Two new washwater and solids equalization/settling basins plus two new drying beds; each basin max ~300,000 gallons; decanting structure in each\", \"source\": \"p.119\", \"unit\": \"gal\", \"value\": \"300000 each\"}, {\"id\": \"DR-WW-04\", \"item\": \"Wastewater PS grades and basins\", \"quote\": \"WASTEWATER PUMP STATION grade 455.0, 440.3, floor 430.0; SETTLING BASINS top 459.0 MAX WS 458.0 OVERFLOW TO RIVER 451.0; DRYING BEDS top 459.0 grade 452.5\", \"source\": \"dwg p.136\", \"unit\": \"ft\", \"value\": \"see quote\"}]}"