# Copy to .env. Never commit real keys.
META_API_KEY=
MUSE_BUDGET_USD=5
BASETEN_API_KEY=
BASETEN_BUDGET_USD=90
# Required before non-local HTTP access. Keep WEB_ALLOW_RUNS=0 for replay-only demos.
WEB_AUTH_TOKEN=
WEB_ALLOW_RUNS=0
WEB_ALLOW_WRITES=0
# Uploaded projects default to this non-contributor model. Contributor use needs an explicit ALLOW_PRIVATE_CONTRIBUTOR=1.
PRIVATE_MODEL=muse-spark-1.3
ALLOW_PRIVATE_CONTRIBUTOR=0
# Public source PDFs and uploaded project data. Defaults to a sibling case-data directory when present.
PLANTAGENT_DATA_ROOT=
